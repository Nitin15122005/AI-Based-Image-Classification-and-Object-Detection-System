# Copy this file to `.env` and adjust for your environment. Never commit `.env`.

APP_NAME="VisionAI API"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"

# PostgreSQL connection (psycopg3 SQLAlchemy dialect). Works with a local
# Postgres instance or a hosted Neon database (Neon requires ?sslmode=require).
# Local example:
DATABASE_URL="postgresql+psycopg://visionai:visionai_dev_pw@127.0.0.1:5432/visionai"
# Neon example:
# DATABASE_URL="postgresql+psycopg://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require"

# Where uploaded originals and generated annotated images are stored on disk.
UPLOAD_DIR="./storage/uploads"
RESULT_DIR="./storage/results"
MAX_UPLOAD_MB=25

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS="http://localhost:5173"

# "real" (production: pretrained YOLO11s + fine-tuned ResNet50) or "mock"
# (no model weights required — useful for frontend-only dev or environments
# without the ~2.5GB PyTorch/CUDA stack installed).
MODEL_MODE="real"

# Production detector: the OFFICIAL PRETRAINED Ultralytics YOLO11s COCO
# checkpoint — not the fine-tuned ml_outputs/models/detection/best_detection.pt,
# which the training notebook's own baseline comparison showed underperforms
# the pretrained weights (see ml_outputs/outputs/metrics/detection_baseline_delta.json).
# Ultralytics auto-downloads this file the first time it's loaded if not present.
DETECTION_MODEL_PATH="../yolo11s.pt"

# Production classifier: the fine-tuned ResNet50 checkpoint.
CLASSIFICATION_MODEL_PATH="../ml_outputs/models/classification/best_classifier.pth"

# Where the training notebook's real evaluation artifacts live (metrics
# JSON/CSV files under <ML_OUTPUTS_DIR>/outputs/metrics/), read by
# metrics_service.py for GET /api/v1/metrics.
ML_OUTPUTS_DIR="../ml_outputs"
